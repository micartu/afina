<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- AfinApp.AppHost -->
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.6.0" />
    <PackageVersion Include="Aspire.Hosting.Keycloak" Version="13.6.0-preview.1.26479.8" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.0" />
